  "keywords": ["playwright", "e2e", "testing", "django"],
  "author": "Antigravity QA",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
