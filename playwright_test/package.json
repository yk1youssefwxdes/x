{
  "name": "school-erp-playwright-e2e",
  "version": "1.0.0",
  "description": "Comprehensive Playwright End-to-End Test Suite for School ERP",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
